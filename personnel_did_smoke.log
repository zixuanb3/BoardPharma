 55.     di as text "============================================================"
 56. 
.     * -------- read and stack cohort data --------
.     local first = 1
 57.     local used_cohorts ""
 58.     local skipped_cohorts ""
 59. 
.     foreach cohort of local cohort_list {
 60.         local data_file "`input_path'/reg_panel_cohort_`cohort'_tg`treatment_group'.csv"
 61. 
.         capture confirm file "`data_file'"
 62.         if _rc {
 63.             di as error "Missing cohort file, skipping cohort: `data_file'"
 64.             local skipped_cohorts "`skipped_cohorts' `cohort'"
 65.             continue
 66.         }
 67. 
.         capture noisily import delimited "`data_file'", clear varnames(1) case(preserve)
 68.         if _rc {
 69.             di as error "Failed to import cohort file, skipping cohort: `data_file'"
 70.             local skipped_cohorts "`skipped_cohorts' `cohort'"
 71.             continue
 72.         }
 73. 
.         local bad_cohort 0
 74.         foreach v in year quarter treat event_time {
 75.             capture confirm variable `v'
 76.             if _rc {
 77.                 di as error "Missing required variable `v' in `data_file'; skipping cohort"
 78.                 local skipped_cohorts "`skipped_cohorts' `cohort'"
 79.                 local bad_cohort 1
 80.                 continue, break
 81.             }
 82.             capture confirm numeric variable `v'
 83.             if _rc {
 84.                 capture noisily destring `v', replace ignore(" ,")
 85.                 if _rc {
 86.                     di as error "Could not destring `v' in `data_file'; skipping cohort"
 87.                     local skipped_cohorts "`skipped_cohorts' `cohort'"
 88.                     local bad_cohort 1
 89.                     continue, break
 90.                 }
 91.             }
 92.         }
 93.         if `bad_cohort' {
 94.             continue
 95.         }
 96. 
.         gen data_cohort = `cohort'
 97.         gen q_time = yq(year, quarter)
 98.         format q_time %tq
 99.         gen event_cohort_q = yq(data_cohort, 1) if treat == 1
100.         replace event_cohort_q = . if treat == 0 | missing(treat)
101. 
.         keep if event_time >= -8 & event_time <= 11
102.         count
103.         if r(N) == 0 {
104.             di as error "No rows in event window for cohort `cohort'; skipping cohort"
105.             local skipped_cohorts "`skipped_cohorts' `cohort'"
106.             continue
107.         }
108. 
.         if `first' {
109.             tempfile stack
110.             save `stack', replace
111.             local first = 0
112.         }
113.         else {
114.             append using `stack'
115.             save `stack', replace
116.         }
117.         local used_cohorts "`used_cohorts' `cohort'"
118.     }
119. 
.     di as text "used_cohorts=`used_cohorts'"
120.     di as text "skipped_cohorts=`skipped_cohorts'"
121. 
.     if `first' {
122.         di as error "No cohort data were available after reading and event-window filtering. Skipping this parameter combination."
123.         log close
124.         continue
125.     }
126. 
.     use `stack', clear
127. 
.     * -------- validate and transform variables --------
.     local numeric_vars year quarter treat event_time share_atc3 balanced_panel `target' ///
>         pre_retain_W pre_exit_W pre_dissolved_W ///
>         sameq_retain sameq_exit sameq_dissolved ///
>         post_retain post_exit post_dissolved
128.     local bad_numeric 0
129. 
.     foreach v of local numeric_vars {
130.         capture confirm variable `v'
131.         if _rc {
132.             di as error "Missing required variable after stacking: `v'"
133.             local bad_numeric 1
134.         }
135.         else {
136.             capture confirm numeric variable `v'
137.             if _rc {
138.                 capture noisily destring `v', replace ignore(" ,")
139.                 if _rc {
140.                     di as error "Could not destring required variable after stacking: `v'"
141.                     local bad_numeric 1
142.                 }
143.             }
144.         }
145.     }
146. 
.     capture confirm variable A
147.     if _rc {
148.         di as error "Missing required firm-pair variable after stacking: A"
149.         local bad_numeric 1
150.     }
151.     capture confirm variable B
152.     if _rc {
153.         di as error "Missing required firm-pair variable after stacking: B"
154.         local bad_numeric 1
155.     }
156.     capture confirm variable product
157.     if _rc {
158.         di as error "Missing required product variable after stacking: product"
159.         local bad_numeric 1
160.     }
161. 
.     if `bad_numeric' {
162.         di as error "Skipping this parameter combination because required variables are missing or not numeric."
163.         log close
164.         continue
165.     }
166. 
.     gen y = log(`target')
167. 
.     egen id = group(A B product data_cohort)
168.     format q_time %tq
169. 
.     egen D_confounded = rowmax( ///
>         pre_retain_W pre_exit_W pre_dissolved_W ///
>         sameq_retain sameq_exit sameq_dissolved ///
>         post_retain post_exit post_dissolved ///
>     )
170.     replace D_confounded = 0 if treat == 0
171.     replace D_confounded = 0 if missing(D_confounded)
172. 
.     replace share_atc3 = 0 if missing(share_atc3)
173.     gen group4 = .
174.     replace group4 = 0 if treat == 1 & share_atc3 == 0 & D_confounded == 0
175.     replace group4 = 1 if treat == 1 & share_atc3 == 1 & D_confounded == 0
176.     replace group4 = 2 if treat == 1 & share_atc3 == 0 & D_confounded == 1
177.     replace group4 = 3 if treat == 1 & share_atc3 == 1 & D_confounded == 1
178.     replace group4 = 0 if treat == 0
179. 
.     label define group4_lbl 0 "clean_nonshare" 1 "clean_share" 2 "confounded_nonshare" 3 "confounded_share", replace
180.     label values group4 group4_lbl
181. 
.     if `balanced_only' == 1 {
182.         keep if balanced_panel == 1
183.         di as text "Applied balanced_panel == 1 filter."
184.     }
185. 
.     count
186.     if r(N) == 0 {
187.         di as error "No rows remain after balanced-panel filtering. Skipping this parameter combination."
188.         log close
189.         continue
190.     }
191. 
.     if `fe_level' == 1 {
192.         egen fe_cqt_A = group(data_cohort q_time A)
193.         egen fe_cqt_B = group(data_cohort q_time B)
194.         local fe_spec "id fe_cqt_A fe_cqt_B"
195.         local fe_title "cohort-quarter-by-firm A and cohort-quarter-by-firm B"
196.     }
197.     else if `fe_level' == 2 {
198.         egen fe_ct = group(data_cohort q_time)
199.         egen fe_c_A = group(data_cohort A)
200.         egen fe_c_B = group(data_cohort B)
201.         local fe_spec "id fe_ct fe_c_A fe_c_B"
202.         local fe_title "cohort-quarter, cohort-by-firm A, and cohort-by-firm B"
203.     }
204. 
.     * -------- compute sample stats --------
.     count if treat == 0
205.     local obs_control = r(N)
206.     count if treat == 1 & group4 == 0
207.     local obs_group0 = r(N)
208.     count if treat == 1 & group4 == 1
209.     local obs_group1 = r(N)
210.     count if treat == 1 & group4 == 2
211.     local obs_group2 = r(N)
212.     count if treat == 1 & group4 == 3
213.     local obs_group3 = r(N)
214. 
.     tempvar tag_pair_control tag_pair_g0 tag_pair_g1 tag_pair_g2 tag_pair_g3
215.     egen `tag_pair_control' = tag(A B) if treat == 0
216.     egen `tag_pair_g0' = tag(A B) if treat == 1 & group4 == 0
217.     egen `tag_pair_g1' = tag(A B) if treat == 1 & group4 == 1
218.     egen `tag_pair_g2' = tag(A B) if treat == 1 & group4 == 2
219.     egen `tag_pair_g3' = tag(A B) if treat == 1 & group4 == 3
220. 
.     count if `tag_pair_control' == 1
221.     local pairs_control = r(N)
222.     count if `tag_pair_g0' == 1
223.     local pairs_group0 = r(N)
224.     count if `tag_pair_g1' == 1
225.     local pairs_group1 = r(N)
226.     count if `tag_pair_g2' == 1
227.     local pairs_group2 = r(N)
228.     count if `tag_pair_g3' == 1
229.     local pairs_group3 = r(N)
230. 
.     tempvar tag_product_g0 tag_product_g1 tag_product_g2 tag_product_g3
231.     egen `tag_product_g0' = tag(product) if treat == 1 & group4 == 0
232.     egen `tag_product_g1' = tag(product) if treat == 1 & group4 == 1
233.     egen `tag_product_g2' = tag(product) if treat == 1 & group4 == 2
234.     egen `tag_product_g3' = tag(product) if treat == 1 & group4 == 3
235. 
.     count if `tag_product_g0' == 1
236.     local products_group0 = r(N)
237.     count if `tag_product_g1' == 1
238.     local products_group1 = r(N)
239.     count if `tag_product_g2' == 1
240.     local products_group2 = r(N)
241.     count if `tag_product_g3' == 1
242.     local products_group3 = r(N)
243. 
.     di as text "sample counts:"
244.     di as text "obs_control=`obs_control'"
245.     di as text "obs_group0=`obs_group0'"
246.     di as text "obs_group1=`obs_group1'"
247.     di as text "obs_group2=`obs_group2'"
248.     di as text "obs_group3=`obs_group3'"
249.     di as text "pairs_control=`pairs_control'"
250.     di as text "pairs_group0=`pairs_group0'"
251.     di as text "pairs_group1=`pairs_group1'"
252.     di as text "pairs_group2=`pairs_group2'"
253.     di as text "pairs_group3=`pairs_group3'"
254.     di as text "products_group0=`products_group0'"
255.     di as text "products_group1=`products_group1'"
256.     di as text "products_group2=`products_group2'"
257.     di as text "products_group3=`products_group3'"
258. 
.     forvalues g = 0/3 {
259.         local this_obs = .
260.         if `g' == 0 {
261.             local this_obs `obs_group0'
262.         }
263.         else if `g' == 1 {
264.             local this_obs `obs_group1'
265.         }
266.         else if `g' == 2 {
267.             local this_obs `obs_group2'
268.         }
269.         else if `g' == 3 {
270.             local this_obs `obs_group3'
271.         }
272.         if `this_obs' == 0 {
273.             di as result "Warning: no treated observations for group4 == `g'. did_imputation will still run; coefficients may be missing."
274.         }
275.     }
276. 
.     foreach g in 0 1 2 3 {
277.         matrix did_b_g`g' = J(1, `n_total', .)
278.         matrix did_V_g`g' = J(`n_total', `n_total', 0)
279.         matrix colnames did_b_g`g' = `coef_names'
280.         matrix colnames did_V_g`g' = `coef_names'
281.         matrix rownames did_V_g`g' = `coef_names'
282.     }
283. 
.     * -------- run did_imputation --------
.     di as text "fixed effects: `fe_title'"
284.     di as text "did_imputation command:"
285.     di as text "did_imputation y id `timevar' `gvar', fe(`fe_spec') horizons(`did_horizons') pretrends(`did_pretrend') hetby(group4) autosample tol(0.1) minn(0)"
286. 
.     capture noisily did_imputation y id `timevar' `gvar', ///
>         fe(`fe_spec') ///
>         horizons(`did_horizons') ///
>         pretrends(`did_pretrend') ///
>         hetby(group4) ///
>         autosample tol(0.1) minn(0)
287.     local did_rc = _rc
288. 
.     if `did_rc' != 0 {
289.         di as error "did_imputation failed: r(`did_rc'). Skipping this parameter combination."
290.         log close
291.         continue
292.     }
293. 
.     local N_est = e(N)
294.     matrix did_b_full = e(b)
295.     matrix did_V_full = e(V)
296.     local did_ncol = colsof(did_b_full)
297.     local did_names : colnames did_b_full
298. 
.     * -------- map e(b) and e(V) to four group matrices --------
.     forvalues g = 0/3 {
299.         matrix col_map_g`g' = J(1, `n_total', 0)
300. 
.         forvalues i = 1/`n_total' {
301.             local coef_name : word `i' of `coef_names'
302.             local found_col 0
303.             local candidate_list ""
304. 
.             if substr("`coef_name'", 1, 4) == "pre_" {
305.                 local k = substr("`coef_name'", 5, .)
306.                 local candidate_list pre`k'_`g' pre`k'
307.             }
308.             else if substr("`coef_name'", 1, 5) == "post_" {
309.                 local h = substr("`coef_name'", 6, .)
310.                 local candidate_list tau`h'_`g'
311.             }
312. 
.             foreach candidate of local candidate_list {
313.                 if `found_col' == 0 {
314.                     forvalues c = 1/`did_ncol' {
315.                         local cn : word `c' of `did_names'
316.                         if "`cn'" == "`candidate'" {
317.                             local found_col `c'
318.                         }
319.                     }
320.                 }
321.             }
322. 
.             if `found_col' > 0 {
323.                 matrix col_map_g`g'[1, `i'] = `found_col'
324.                 matrix did_b_g`g'[1, `i'] = did_b_full[1, `found_col']
325.             }
326.             else {
327.                 di as result "Coefficient not estimated; leaving missing: group4=`g', coef=`coef_name'"
328.             }
329.         }
330. 
.         forvalues i = 1/`n_total' {
331.             local ci = el(col_map_g`g', 1, `i')
332.             if `ci' == 0 {
333.                 continue
334.             }
335.             forvalues j = 1/`n_total' {
336.                 local cj = el(col_map_g`g', 1, `j')
337.                 if `cj' == 0 {
338.                     continue
339.                 }
340.                 matrix did_V_g`g'[`i', `j'] = did_V_full[`ci', `cj']
341.             }
342.         }
343.     }
344. 
.     * -------- export regression results for re-plotting --------
.     preserve
345.     clear
346.     set obs 0
347. 
.     gen str32 definition = ""
348.     gen str32 event_type = ""
349.     gen str16 control_set = ""
350.     gen str1 treatment_group = ""
351.     gen balanced_only = .
352.     gen fe_level = .
353.     gen str16 target = ""
354.     gen str20 transform = ""
355.     gen group4 = .
356.     gen str32 group_label = ""
357.     gen str16 coef_name = ""
358.     gen rel_quarter = .
359.     gen estimate = .
360.     gen variance = .
361.     gen std_error = .
362.     gen ci_lb_95 = .
363.     gen ci_ub_95 = .
364.     gen N = .
365.     gen obs_control = .
366.     gen obs_group0 = .
367.     gen obs_group1 = .
368.     gen obs_group2 = .
369.     gen obs_group3 = .
370.     gen pairs_control = .
371.     gen pairs_group0 = .
372.     gen pairs_group1 = .
373.     gen pairs_group2 = .
374.     gen pairs_group3 = .
375.     gen products_group0 = .
376.     gen products_group1 = .
377.     gen products_group2 = .
378.     gen products_group3 = .
379. 
.     forvalues g = 0/3 {
380.         local this_group_label "clean_nonshare"
381.         if `g' == 1 {
382.             local this_group_label "clean_share"
383.         }
384.         else if `g' == 2 {
385.             local this_group_label "confounded_nonshare"
386.         }
387.         else if `g' == 3 {
388.             local this_group_label "confounded_share"
389.         }
390. 
.         forvalues i = 1/`n_total' {
391.             local this_coef : word `i' of `coef_names'
392.             local b = el(did_b_g`g', 1, `i')
393.             local v = el(did_V_g`g', `i', `i')
394.             if missing(`b') {
395.                 local v = .
396.             }
397. 
.             local se = .
398.             local lb = .
399.             local ub = .
400.             local rel_q = .
401. 
.             if !missing(`v') & `v' >= 0 {
402.                 local se = sqrt(`v')
403.             }
404.             if !missing(`b') & !missing(`se') {
405.                 local lb = `b' - 1.96 * `se'
406.                 local ub = `b' + 1.96 * `se'
407.             }
408. 
.             if substr("`this_coef'", 1, 4) == "pre_" {
409.                 local rel_q = -real(substr("`this_coef'", 5, .))
410.             }
411.             else if substr("`this_coef'", 1, 5) == "post_" {
412.                 local rel_q = real(substr("`this_coef'", 6, .))
413.             }
414. 
.             local row = _N + 1
415.             set obs `row'
416.             replace definition = "`definition'" in `row'
417.             replace event_type = "`event_type'" in `row'
418.             replace control_set = "`control_set'" in `row'
419.             replace treatment_group = "`treatment_group'" in `row'
420.             replace balanced_only = `balanced_only' in `row'
421.             replace fe_level = `fe_level' in `row'
422.             replace target = "`target'" in `row'
423.             replace transform = "`std'" in `row'
424.             replace group4 = `g' in `row'
425.             replace group_label = "`this_group_label'" in `row'
426.             replace coef_name = "`this_coef'" in `row'
427.             replace rel_quarter = `rel_q' in `row'
428.             replace estimate = `b' in `row'
429.             replace variance = `v' in `row'
430.             replace std_error = `se' in `row'
431.             replace ci_lb_95 = `lb' in `row'
432.             replace ci_ub_95 = `ub' in `row'
433.             replace N = `N_est' in `row'
434.             replace obs_control = `obs_control' in `row'
435.             replace obs_group0 = `obs_group0' in `row'
436.             replace obs_group1 = `obs_group1' in `row'
437.             replace obs_group2 = `obs_group2' in `row'
438.             replace obs_group3 = `obs_group3' in `row'
439.             replace pairs_control = `pairs_control' in `row'
440.             replace pairs_group0 = `pairs_group0' in `row'
441.             replace pairs_group1 = `pairs_group1' in `row'
442.             replace pairs_group2 = `pairs_group2' in `row'
443.             replace pairs_group3 = `pairs_group3' in `row'
444.             replace products_group0 = `products_group0' in `row'
445.             replace products_group1 = `products_group1' in `row'
446.             replace products_group2 = `products_group2' in `row'
447.             replace products_group3 = `products_group3' in `row'
448.         }
449.     }
450. 
.     sort group4 rel_quarter
451.     export delimited using "`csv_path'/`file_stub'.csv", replace
452.     restore
453. 
.     * Common pretrends are copied to all groups in the CSV, but shown once in the graph.
.     forvalues g = 1/3 {
454.         forvalues i = 1/`n_total' {
455.             local coef_name : word `i' of `coef_names'
456.             if substr("`coef_name'", 1, 4) == "pre_" {
457.                 matrix did_b_g`g'[1, `i'] = .
458.                 forvalues j = 1/`n_total' {
459.                     matrix did_V_g`g'[`i', `j'] = 0
460.                     matrix did_V_g`g'[`j', `i'] = 0
461.                 }
462.             }
463.         }
464.     }
465. 
.     * -------- plot four group4 ATT curves together --------
.     capture noisily event_plot did_b_g0#did_V_g0 did_b_g1#did_V_g1 did_b_g2#did_V_g2 did_b_g3#did_V_g3, ///
>         stub_lag(post_# post_# post_# post_#) ///
>         stub_lead(pre_# pre_# pre_# pre_#) ///
>         trimlead(`trimlead') trimlag(`trimlag') ///
>         plottype(scatter) ciplottype(rcap) ///
>         together perturb(-`perturb_span'(`perturb_increment')`perturb_span') noautolegend ///
>         graph_opt( ///
>             title("`definition' `event_type' `control_set' tg=`treatment_group' balanced=`balanced_only' fe=`fe_level' `target' log", size(vsmall)) ///
>             xtitle("Quarters since event", size(small)) ///
>             ytitle("log(`target')", size(small)) ///
>             xlabel(`xlabel_spec', nogrid) ///
>             legend(order(1 "clean, non-share" 3 "clean, share" 5 "confounded, non-share" 7 "confounded, share") ///
>                 rows(2) position(6) region(style(none))) ///
>             xline(-0.5, lcolor(gs8) lpattern(dash)) ///
>             yline(0, lcolor(gs8)) ///
>             graphregion(color(white)) bgcolor(white) ///
>             ylabel(, angle(horizontal)) ///
>         ) ///
>         lag_opt1(msymbol(O) color(black)) lag_ci_opt1(color(black)) ///
>         lag_opt2(msymbol(Th) color(navy)) lag_ci_opt2(color(navy)) ///
>         lag_opt3(msymbol(S) color(maroon)) lag_ci_opt3(color(maroon)) ///
>         lag_opt4(msymbol(D) color(green)) lag_ci_opt4(color(green))
466.     local plot_rc = _rc
467. 
.     if `plot_rc' == 0 {
468.         graph export "`fig_path'/`file_stub'.png", replace width(`graph_width')
469.     }
470.     else {
471.         di as error "event_plot failed: r(`plot_rc'). CSV output was still exported."
472.     }
473. 
.     di as text "success: `file_stub'"
474.     log close
475. 
. }
