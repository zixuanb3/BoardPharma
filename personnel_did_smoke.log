. // ================================================================
. // Purpose:
. // Run stacked did_imputation event-study regressions for
. // firm-pair-product-quarter personnel panels.
. //
. // Process:
. // 1. Loop over personnel definitions, event types, control sets,
. //    treatment groups, balanced-panel filters, FE specifications, and targets.
. // 2. Import 2009-2017 cohort CSVs and stack available cohorts.
. // 3. Build log outcome, unit/time/cohort variables, D_confounded, and group4.
. // 4. Estimate did_imputation with hetby(group4).
. // 5. Export group4 x event-time coefficient CSVs and event_plot figures.
. //
. // Input:
. // - data/personnel_regression_panels/{definition}/retain3yr/{event_type}/
. //   {control_set}/treatment_group_{A|B}/reg_panel_cohort_{cohort}_tg{A|B}.csv
. //
. // Output:
. // - figures/personnel_did_imputation/...
. // - csv/personnel_did_imputation/...
. // - logs/personnel_did_imputation/...
. // ================================================================
. 
. * ================= user config =================
. local definitions medium_board_csuite

. local event_types to_B_not_in_A

. local control_sets C6B

. local treatment_groups B

. local targets price1

. local standardize_types log_transform

. local fe_levels 2

. local balanced_only_values 0

. local cohort_list 2009 2010 2011 2012 2013 2014 2015 2016 2017

. 
. local did_horizons 0/11

. local did_pretrend 8

. local coef_names pre_8 pre_7 pre_6 pre_5 pre_4 pre_3 pre_2 pre_1 post_0 post_1 post_2 post_3 post_4 post_5 post_6 post_7 post_8 post_9 post_10 post_11

. local n_total 20

. local trimlead 8

. local trimlag 11

. local xlabel_spec "-8(1)11"

. local graph_width 3000

. local perturb_step 0.10

. local perturb_span 0.30

. local perturb_increment = 2 * `perturb_step'

. local timevar q_time

. local gvar event_cohort_q

. 
. * ================= path =================
. local code_path "`c(pwd)'"

. local code_path = subinstr("`code_path'", "\", "/", .)

. 
. if regexm("`code_path'", "/3_event_study$") {
.     local parent_path = regexr("`code_path'", "/[^/]+$", "")
.     local project_path = regexr("`parent_path'", "/[^/]+$", "")
. }

. else if regexm("`code_path'", "/codes$") {
.     local project_path = regexr("`code_path'", "/[^/]+$", "")
. }

. else {
.     local parent_path = regexr("`code_path'", "/[^/]+$", "")
.     local project_path = regexr("`parent_path'", "/[^/]+$", "")
. }

. 
. local input_root "`project_path'/data/personnel_regression_panels"

. local fig_root "`project_path'/figures/personnel_did_imputation"

. local csv_root "`project_path'/csv/personnel_did_imputation"

. local log_root "`project_path'/logs/personnel_did_imputation"

. 
. cap mkdir "`project_path'/figures"

. cap mkdir "`project_path'/csv"

. cap mkdir "`project_path'/logs"

. cap mkdir "`fig_root'"

. cap mkdir "`csv_root'"

. cap mkdir "`log_root'"

. 
. * ================= loop =================
. foreach definition of local definitions {
  2. foreach event_type of local event_types {
  3. foreach control_set of local control_sets {
  4. foreach treatment_group of local treatment_groups {
  5. foreach balanced_only of local balanced_only_values {
  6. foreach fe_level of local fe_levels {
  7. foreach target of local targets {
  8. foreach std of local standardize_types {
  9. 
.     if !inlist("`treatment_group'", "A", "B") {
 10.         di as error "treatment_group must be one of: A, B"
 11.         exit 198
 12.     }
 13.     if !inlist(`balanced_only', 0, 1) {
 14.         di as error "balanced_only must be one of: 0, 1"
 15.         exit 198
 16.     }
 17.     if !inlist(`fe_level', 1, 2) {
 18.         di as error "fe_level must be one of: 1, 2"
 19.         exit 198
 20.     }
 21.     if "`std'" != "log_transform" {
 22.         di as error "Only log_transform is configured for this do-file."
 23.         exit 198
 24.     }
 25. 
.     * -------- setup paths for this iteration --------
.     local input_path "`input_root'/`definition'/retain3yr/`event_type'/`control_set'/treatment_group_`treatment_group'"
 26. 
.     foreach base in "`fig_root'" "`csv_root'" "`log_root'" {
 27.         cap mkdir "`base'/`definition'"
 28.         cap mkdir "`base'/`definition'/`event_type'"
 29.         cap mkdir "`base'/`definition'/`event_type'/`control_set'"
 30.         cap mkdir "`base'/`definition'/`event_type'/`control_set'/treatment_group_`treatment_group'"
 31.         cap mkdir "`base'/`definition'/`event_type'/`control_set'/treatment_group_`treatment_group'/balanced_`balanced_only'"
 32.         cap mkdir "`base'/`definition'/`event_type'/`control_set'/treatment_group_`treatment_group'/balanced_`balanced_only'/fe`fe_level'"
 33.         cap mkdir "`base'/`definition'/`event_type'/`control_set'/treatment_group_`treatment_group'/balanced_`balanced_only'/fe`fe_level'/`target'"
 34.     }
 35. 
.     local fig_path "`fig_root'/`definition'/`event_type'/`control_set'/treatment_group_`treatment_group'/balanced_`balanced_only'/fe`fe_level'/`target'"
 36.     local csv_path "`csv_root'/`definition'/`event_type'/`control_set'/treatment_group_`treatment_group'/balanced_`balanced_only'/fe`fe_level'/`target'"
 37.     local log_path "`log_root'/`definition'/`event_type'/`control_set'/treatment_group_`treatment_group'/balanced_`balanced_only'/fe`fe_level'/`target'"
 38.     local file_stub "`event_type'_`control_set'_tg`treatment_group'_balanced`balanced_only'_fe`fe_level'_`target'_log_hetby4"
 39. 
.     cap log close
 40.     log using "`log_path'/`file_stub'.log", text replace
 41. 
.     di as text "============================================================"
 42.     di as text "personnel did_imputation event-study"
 43.     di as text "input_path=`input_path'"
 44.     di as text "cohort_list=`cohort_list'"
 45.     di as text "definition=`definition'"
 46.     di as text "event_type=`event_type'"
 47.     di as text "control_set=`control_set'"
 48.     di as text "treatment_group=`treatment_group'"
 49.     di as text "balanced_only=`balanced_only'"
 50.     di as text "fe_level=`fe_level'"
 51.     di as text "target=`target'"
