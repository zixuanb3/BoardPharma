// ================================================================
// Purpose:
// Run stacked did_imputation or csdid event studies for ATC-sharing
// heterogeneity in the current 1.1 quarterly movement-event cohorts.
//
// Process:
// 1. Select roster variant, late, req1_spec, stay_spec, share_time_spec, dynamic_share,
//    treatment group, event, outcome, and Kappa specification.
// 2. Read the quarterly cohorts entered manually below. For pre2, discover
//    saved cohorts when no manual list is supplied and skip cohorts without
//    treated observations. Restricted dissolution uses the original cohort
//    list and also checks for treated observations before stacking. When ruleout=1,
//    calculate the selected threshold_mode score within each complete cohort
//    panel and remove BoardName-product histories above ruleout_threshold.
//    Cohorts left without treated observations are not stacked.
// 3. Stack retained cohorts using their saved event, balance, treatment, and
//    ATC3-sharing definitions; ruleout never reconstructs these definitions.
// 4. Use input req2 with the original annual req1 regression treatment:
//    no req2 control-variation filter; control both other event types using
//    their first observed event quarter within each stack.
// 5. Apply the selected outlier treatment and outcome transformation.
//    Retain the original FE1, hetby, pretrends(3), horizons(0/7), and firm
//    clustering. Regression, coefficient extraction, CSV export, and plotting
//    blocks are copied unchanged from 3_event_study/did_imputation_event_study.do.
// 6. For csdid, estimate quarterly ATT(g,t) with a -1 base in separate
//    sharing groups. With dynamic sharing, select whole unit histories by the
//    target quarter's label and retain only that quarter's estimates.
//    FE1 pools stacks and FE2 restricts comparisons to each
//    stack. Aggregate by paired treated-unit counts with firm-clustered inference.
//    Other-event, Kappa, and ATC controls enter as earlier-quarter covariates.
// 7. Export coefficient CSVs, logs, and overlaid dynamic-effect figures.
//    Sample counts use the estimator's e(sample), taking the union across
//    contributing csdid fits for each sharing curve.
//
// Input:
// - data/`input_subtree'/cohort_data/<variant>/late_<late>/req1_<req1_spec>/
//   stay_<stay_spec>/share_time_<share_time_spec>[_ds1]/[dai1/]
//   quarter-level_<side>_without_<other>/event/req2/Not/
//   <event>_quarter_cohort_<YYYYqQ>_balanced.csv
// - data/kappa/ssr_kappa_firm_level_v5.csv when Kappa is enabled,
//   generated by 1_data_prep/KappaFirmLevelMaker.py from InterimData.
//
// Output:
// - figures/`output_subtree'/<spec_tag>/cluster_firm/q_<group>_lsn/<event>/req2/price*/...
// - csv/`output_subtree'/<spec_tag>/cluster_firm/q_<group>_lsn/<event>/req2/price*/...
// - logs/`output_subtree'/<spec_tag>/cluster_firm/q_<group>_lsn/<event>/req2/price*/...
// spec_tag identifies the roster and upstream settings:
// i/d = imputed/drop_sentinel_yearquarter; l = late; r/s/h =
// req1_spec/stay_spec/share_time_spec; n/o = new/origin; sp = stay_pre2.
// Append _ds1 for dynamic sharing. The manual cohort keys use the base tag.
// csdid appends the estimator and FE level to result filenames.
// Requires event_plot and the selected estimator (csdid 1.81 and drdid for csdid).
// ================================================================

* ================= USER CONFIG =================
* did_imputation preserves the legacy workflow. csdid requires separate_modes=1.
* Optional twelfth argument overrides the estimator.
local eventstudy_command csdid
* did_imputation
* ever_board: 0 preserves legacy paths/settings; 1 uses all-role continuity.
local ever_board 1
* ieoc_ref: 1 uses BP only for IE/OC-covered quarters in observed pair-years.
local ieoc_ref 1
* 0: original cohorts. 1: read the restricted dissolution treatment sample.
* The eleventh do-file argument overrides this setting.
local dissolution_after_interlock 0
* rule_outliers_out: 1 removes abnormal company-products inside each cohort panel.
local rule_outliers_out 1
* One or more strict cutoffs for the selected threshold_mode score.
* Each listed value runs separately.
* A multi-value ninth do-file argument must be enclosed in quotes.
local ruleout_threshold 100 10
* threshold_mode: price10 uses (price1 max/min)/(price0 max/min);
* price1 uses price1 max/min. Optional tenth do-file argument overrides it.
local threshold_mode "price1"
* dynamic_share: 0 reads static labels; 1 reads quarterly labels with share_time_spec=new.
* With csdid, 1 selects whole histories separately for each target quarter.
* Optional eighth do-file argument overrides this setting.
local dynamic_share 0
local atcs atc3
local large_sample 1
local personnel_definition narrow
local separate_modes 1
local outlier_treatment "winsorize"
* Allowed values: none, winsorize, trim.
local outlier_treatment_percentile "p95"
local events interlock_dissolution to_B_still_in_A to_B_not_in_A
* interlock_dissolution to_B_still_in_A to_B_not_in_A
local controls not
local targets price1
*price1 price0 quantity revenue
local standardize_types log_transform
local event_types event
local reqs 2
local control_for_other_events none
* other_event none

local control_kappas none
* kappa_asy
local control_atcs none
* separate includes ATC3 fixed effects. none omits ATC3 fixed effects.
local treatment_groups A B
local include_eventpair_values 0
local fe_levels 2
* 1 2
local cluster_levels firm

* The current upstream cohort inputs already contain the narrow sample.
local roster_mode dropp
* imputed
* Four upstream parameters: 2 x 2 x 2 x 2 = 16 settings per roster.
local late_values 3
* 0
local req1_specs new
* origin
local stay_specs new
* Allowed stay rules: new, origin, pre2 (eight pre-dissolution quarters).
local share_time_specs new
* origin

local coef_names pre_3 pre_2 pre_1 post_0 post_1 post_2 post_3 post_4 post_5 post_6 post_7
local n_total 11
local trimlead 3
local trimlag 7
local xlabel_spec -3(1)7
local graph_width 3000
local perturb_step 0.15
local perturb_span 0.30
local did_horizons 0/7
local did_pretrend 3
local timevar q_time
local gvar event_cohort_q

