clear all
set more off
set trace off
args requested_ever_board requested_targets requested_req1 requested_stay requested_share requested_ieoc_ref requested_rule_outliers_out requested_dynamic_share requested_ruleout_threshold requested_threshold_mode requested_dai requested_eventstudy_command
if "`requested_ever_board'" != "" local ever_board `requested_ever_board'
if "`requested_ieoc_ref'" != "" local ieoc_ref `requested_ieoc_ref'
if "`requested_rule_outliers_out'" != "" local rule_outliers_out `requested_rule_outliers_out'
if "`requested_dynamic_share'" != "" local dynamic_share `requested_dynamic_share'
if "`requested_ruleout_threshold'" != "" local ruleout_threshold `requested_ruleout_threshold'
if "`requested_threshold_mode'" != "" local threshold_mode `requested_threshold_mode'
if "`requested_dai'" != "" local dissolution_after_interlock `requested_dai'
if "`requested_eventstudy_command'" != "" local eventstudy_command `requested_eventstudy_command'
if !inlist("`eventstudy_command'", "did_imputation", "csdid") {
    di as error "eventstudy_command must be did_imputation or csdid"
    exit 198
}
if "`eventstudy_command'" == "csdid" {
    if trim("`separate_modes'") != "1" {
        di as error "csdid requires separate_modes=1"
        exit 198
    }
    foreach level of local fe_levels {
        if !inlist("`level'", "1", "2") {
            di as error "csdid requires fe_levels to contain only 1 and/or 2"
            exit 198
        }
    }
    local coef_names pre_4 pre_3 pre_2 post_0 post_1 post_2 post_3 post_4 post_5 post_6 post_7
    local n_total : word count `coef_names'
    local trimlead 4
    local xlabel_spec -4(1)7
}
if !inlist(`dissolution_after_interlock', 0, 1) exit 198
if !inlist(`ever_board', 0, 1) exit 198
if !inlist(`ieoc_ref', 0, 1) exit 198
if !inlist(`rule_outliers_out', 0, 1) exit 198
if !inlist("`outlier_treatment'", "none", "winsorize", "trim") {
    di as error "outlier_treatment must be one of: none, winsorize, trim"
    exit 198
}
if !inlist("`threshold_mode'", "price10", "price1") {
    di as error "threshold_mode must be one of: price10, price1"
    exit 198
}
local ruleout_thresholds `ruleout_threshold'
if trim("`ruleout_thresholds'") == "" {
    di as error "ruleout_threshold must contain at least one positive number"
    exit 198
}
foreach threshold of local ruleout_thresholds {
    capture confirm number `threshold'
    if _rc {
        di as error "Invalid ruleout_threshold value: `threshold'"
        exit 198
    }
    if `threshold' <= 0 {
        di as error "ruleout_threshold values must be positive: `threshold'"
        exit 198
    }
}
if `rule_outliers_out' == 0 {
    local first_ruleout_threshold : word 1 of `ruleout_thresholds'
    local ruleout_thresholds `first_ruleout_threshold'
}
if !inlist("`dynamic_share'", "0", "1") {
    di as error "dynamic_share must be 0 or 1"
    exit 198
}
if `ieoc_ref' == 1 & `ever_board' != 1 {
    di as error "ieoc_ref=1 requires ever_board=1"
    exit 198
}
if `ever_board' == 1 & "`requested_targets'" == "" local targets price1
if "`requested_targets'" != "" local targets `requested_targets'
if "`requested_req1'" != "" local req1_specs `requested_req1'
if "`requested_stay'" != "" local stay_specs `requested_stay'
